rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // La app no usa Storage: el PDF de la ficha de cliente se arma en
    // el navegador. Se cierra todo para que nadie suba ni lea archivos.
    // Si más adelante se respalda el PDF, abrir solo esa ruta y solo
    // para el admin (ver test/reglas/reglas.test.mjs).
    match /{todo=**} {
      allow read, write: if false;
    }
  }
}
